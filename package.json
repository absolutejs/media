{
  "name": "@absolutejs/media",
  "version": "0.0.1-beta.23",
  "description": "Realtime media primitives for AbsoluteJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/media.git"
  },
  "homepage": "https://github.com/absolutejs/media",
  "bugs": {
    "url": "https://github.com/absolutejs/media/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/manifest.ts --root ./src --outdir dist --target bun && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "config": "absolute config",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,md}\"",
    "release": "bun run format && bun run build && bun publish",
    "test": "bun test ./test/*.test.ts",
    "typecheck": "bun run tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "devDependencies": {
    "@absolutejs/absolute": "^0.19.0-beta.1051",
    "@types/bun": "1.3.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.4.0",
    "@sinclair/typebox": "^0.34.0"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
