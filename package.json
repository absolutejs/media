{
	"name": "@absolutejs/media",
	"version": "0.0.1-beta.19",
	"description": "Realtime media primitives for AbsoluteJS",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/media.git"
	},
	"files": [
		"dist",
		"README.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "CC BY-NC 4.0",
	"author": "Alex Kahn",
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target bun && tsc --emitDeclarationOnly --project tsconfig.json",
		"config": "absolute config",
		"format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,md}\"",
		"release": "bun run format && bun run build && bun publish",
		"test": "bun test ./test/*.test.ts",
		"typecheck": "bun run tsc --noEmit"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"devDependencies": {
		"@absolutejs/absolute": "^0.19.0-beta.1051",
		"@types/bun": "1.3.9",
		"typescript": "^5.9.3"
	}
}
