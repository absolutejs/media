{
  "name": "@absolutejs/media",
  "version": "0.0.1-beta.24",
  "description": "Realtime media primitives for AbsoluteJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/media.git"
  },
  "homepage": "https://github.com/absolutejs/media",
  "bugs": {
    "url": "https://github.com/absolutejs/media/issues"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "changelog.json",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "BSL-1.1",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/manifest.ts --root ./src --outdir dist --target bun --external @absolutejs/manifest --external '@absolutejs/manifest/*' --external @sinclair/typebox --external '@sinclair/typebox/*' && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "config": "absolute config",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,md}\"",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test ./test/*.test.ts",
    "typecheck": "bun run tsc --noEmit",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build && absolute-changelog check",
    "prepublishOnly": "absolute-changelog check"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "devDependencies": {
    "@absolutejs/absolute": "0.20.0-beta.0",
    "@absolutejs/changelog": "^0.2.0",
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@absolutejs/manifest": "0.9.0",
    "@sinclair/typebox": "0.34.52"
  },
  "publishConfig": {
    "access": "public"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
